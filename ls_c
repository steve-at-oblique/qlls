char *_endmsg = NULL;
char _prog_name[] = "ls";

long _stack = 4L * 1024L; /* max. stacksize */
long _mneed = 16L * 1024L; /* max. memory for malloc() */

int own_con; /* set to != 0 if stdout is CON-channel and not redirected */
int is_con;  /* set to != 0 if stdout is a CON-cannel */
