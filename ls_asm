; Talent/Quanta 2.02, Motorola 68000
; Native QDOS job. SEXEC data space: 512 bytes.

ql_mt_inf    equ 0
ql_mt_frjob  equ 5
ql_mt_alchp  equ $18
ql_mt_rechp  equ $19
ql_io_open   equ 1
ql_io_close  equ 2
ql_err_ch    equ -6
ql_err_ef    equ -10
ql_err_bp    equ -15
ql_err_fe    equ -16
io_fmul      equ 3
io_sbyt      equ 5
io_smul      equ 7
sv_basic     equ $10
sv_jobs      equ $68
job_header   equ $68
sb_vars      equ $1e8
smsq_id      equ $534d5351         ; 'SMSQ' system variable identifier
bv_chbas     equ $30
bv_chtop     equ $34
bv_chlen     equ $28
sv_datad     equ $b0

hdr_len     equ 64
hdr_type    equ 5
hdr_nlen    equ 14
hdr_name    equ 16
hdr_date    equ 52
max_name    equ 36
line_len    equ 66                  ; 8+1+16+1+36+3+1

; Stack locals relative to the line buffer in A3. QDOS heap traps can clobber A3.
local_len   equ 64
block_head  equ 0-hdr_len-local_len
block_next  equ block_head+4
block_end   equ block_head+8
entry_head  equ block_head+12
entry_tail  equ block_head+16
sort_field  equ block_head+20
sort_flip   equ block_head+21
one_col     equ block_head+22
prefix_len  equ block_head+24       ; length of filename prefix filter (0 = none)
prefix_buf  equ block_head+26       ; up to 36 prefix characters
dir_len     equ block_head+62       ; parent prefix length, excluding device
search_buf  equ block_head-line_len
search_ptr  equ search_buf-4
work_area   equ search_ptr-line_len

; Packed entries are word-aligned. Each block starts with a link to
; the previous block. Entries link independently in sorted order.
block_size  equ 256
ent_next    equ 0
ent_size    equ 4
ent_date    equ 8
ent_type    equ 12
ent_nlen    equ 13
ent_name    equ 14

; The sort field doubles as its offset in a packed entry.
sort_name   equ 0
sort_size   equ ent_size
sort_date   equ ent_date

start              bra     main
        dc.w    0
        dc.w    $4afb,2
        dc.b    'LS'

main
        moveq   #ql_mt_inf,d0
        trap    #1
        movea.l a0,a5
        movea.w #-1,a4              ; use BASIC #1 only if no redirect is supplied
        movea.l a7,a1              ; original EXEC stack
        lea     work_area(a7),a7
        lea     local_len+line_len+4(a7),a6
        lea     hdr_len(a6),a3
        clr.w   sort_field(a3)     ; name ascending
        clr.w   one_col(a3)
        clr.w   prefix_len(a3)
        clr.w   dir_len(a3)
        clr.w   (a3)               ; no explicit path yet
        bsr     parse_args
        tst.l   d0
        bne     exit_job

        move.l  a4,d0
        tst.w   d0
        bpl.s   send_newline
        moveq   #1,d1
        bsr     get_channel
        tst.l   d0
        bne     exit_job
send_newline
        movea.l a4,a0
        moveq   #10,d1
        moveq   #-1,d3
        moveq   #io_sbyt,d0
        trap    #3
        tst.l   d0
        bne     exit_job
        bsr     select_path
        tst.l   d0
        bne     exit_job
        moveq   #4,d3
        bsr     open_channel
        tst.l   d0
        bne     exit_job
        movea.l a0,a5

        clr.l   block_head(a3)
        clr.l   block_next(a3)
        clr.l   block_end(a3)
        clr.l   entry_head(a3)
        clr.l   entry_tail(a3)

next_entry         movea.l a5,a0
        movea.l a6,a1
        moveq   #0,d1
        moveq   #hdr_len,d2
        moveq   #-1,d3
        moveq   #io_fmul,d0
        trap    #3
        tst.l   d0
        beq.s   check_record
        cmpi.l  #ql_err_ef,d0
        bne.s   close_directory
        tst.w   d1
        beq.s   end_directory
        ; Some drivers can return EOF together with the final record.
check_record       cmpi.w  #hdr_len,d1
        bne.s   bad_record
        tst.l   (a6)
        beq.s   next_entry          ; deleted slot
        move.w  hdr_nlen(a6),d6
        beq.s   next_entry          ; unused slot
        cmpi.w  #max_name,d6
        bhi.s   bad_record
        cmpi.l  #hdr_len,(a6)
        bcs.s   bad_record

        bsr     match_prefix       ; skip entries not matching prefix_buf
        bne.s   next_entry

        bsr     collect
        tst.l   d0
        beq.s   next_entry
        bra.s   close_directory

bad_record         moveq   #ql_err_fe,d0
        bra.s   close_directory
end_directory      moveq   #0,d0
close_directory    move.l  d0,-(a7)
        movea.l a5,a0
        moveq   #ql_io_close,d0
        trap    #2
        move.l  (a7)+,d1
        beq.s   directory_closed
        move.l  d1,d0
directory_closed   tst.l   d0
        bne.s   free_all
        bsr     print_header
        tst.l   d0
        bne.s   free_all
        movea.l entry_head(a3),a6

print_entries      move.l  a6,d0
        beq.s   free_all
        moveq   #0,d6
        move.b  ent_nlen(a6),d6
        bsr     format_line
        movea.l a3,a1
        bsr     send_text
        tst.l   d0
        bne.s   free_all
        movea.l ent_next(a6),a6
        bra.s   print_entries

free_all           move.l  d0,-(a7)
free_one           move.l  block_head(a3),d0
        beq.s   blocks_freed
        movea.l d0,a0
        move.l  (a0),block_head(a3)
        moveq   #ql_mt_rechp,d0
        move.l  a3,-(a7)
        trap    #1
        movea.l (a7)+,a3
        bra.s   free_one
blocks_freed       move.l  (a7)+,d0
exit_job           move.l  d0,d3
; QDOS reclaims the job stack. Channel #1 belongs to SuperBASIC.
remove_job         moveq   #-1,d1
        moveq   #ql_mt_frjob,d0
        trap    #1

open_channel       moveq   #-1,d1
        moveq   #ql_io_open,d0
        trap    #2
        rts

print_header       movea.l search_ptr(a3),a1
        move.w  (a1)+,d2
        bsr.s   send_text
        tst.l   d0
        bne.s   header_done
        lea     header_end(pc),a1
        moveq   #2,d2
send_text          movea.l a4,a0
        moveq   #-1,d3
        moveq   #io_smul,d0
        trap    #3
header_done        rts
header_end         dc.b    ':',10

; An explicit qualified path ending in '_' names a directory. Otherwise
; open its parent and match the final component locally. A bare prefix
; uses DATA_USE, or the stock fallback when no default is configured.
select_path        move.l  sv_datad(a5),d0
        lea     stock_default(pc),a0
        beq.s   got_default
        movea.l d0,a1
        tst.w   (a1)
        beq.s   got_default
        movea.l a1,a0
got_default        move.l  a0,search_ptr(a3)
        move.w  (a3),d1
        beq     path_ready
        ; Save the full operand before splitting it into parent and filter.
        lea     search_buf(a3),a1
        move.l  a1,search_ptr(a3)
        move.w  d1,(a1)+
        lea     2(a3),a2
        move.w  d1,d2
        subq.w  #1,d2
search_copy        move.b  (a2)+,(a1)+
        dbra    d2,search_copy
        cmpi.w  #5,d1
        bcs.s   bare_prefix
        cmpi.b  #'_',6(a3)          ; separator after the four-byte device
        bne.s   bare_prefix
        move.b  5(a3),d0
        subi.b  #'1',d0
        cmpi.b  #7,d0
        bhi.s   bare_prefix

        lea     2(a3,d1.w),a1
        move.w  d1,d2
split_scan         subq.w  #1,d2
        cmpi.b  #'_',-(a1)
        bne.s   split_scan         ; stops at least at the device separator
        addq.w  #1,d2
        sub.w   d2,d1              ; length of the filename prefix
        lea     1(a1),a1
        move.w  d2,(a3)
        movea.l a3,a0
        bra.s   keep_prefix

bare_prefix        lea     2(a3),a1
keep_prefix        tst.w   d1
        beq.s   path_ready
        cmpi.w  #max_name,d1
        bhi.s   path_bad
        move.w  d1,prefix_len(a3)
        lea     prefix_buf(a3),a2
        subq.w  #1,d1
prefix_copy        move.b  (a1)+,(a2)+
        dbra    d1,prefix_copy

        ; Retain the parent path until collection ends, including DATA_USE.
        move.w  (a0),d1
        cmpi.w  #line_len-2,d1
        bhi.s   path_bad
        move.w  d1,d2
        subq.w  #5,d2
        bls.s   path_ready
        move.w  d2,dir_len(a3)
        cmpa.l  a3,a0
        beq.s   path_ready
        movea.l a3,a1
        move.w  (a0)+,(a1)+
        subq.w  #1,d1
parent_copy        move.b  (a0)+,(a1)+
        dbra    d1,parent_copy
        movea.l a3,a0
path_ready         moveq   #0,d0
        rts
path_bad           moveq   #ql_err_bp,d0
        rts

; Some drivers return full names for subdirectory records. Strip the
; requested directory prefix for matching only, and preserve printed names.
match_prefix       move.w  prefix_len(a3),d2
        beq.s   mp_match
        move.w  hdr_nlen(a6),d3
        lea     hdr_name(a6),a2
        move.w  dir_len(a3),d2
        beq.s   mp_leaf
        cmp.w   d3,d2
        bcc.s   mp_leaf
        lea     7(a3),a0
        bsr.s   match_bytes
        beq.s   mp_strip
        lea     hdr_name(a6),a2
        bra.s   mp_leaf
mp_strip           sub.w   dir_len(a3),d3
mp_leaf            move.w  prefix_len(a3),d2
        cmp.w   d3,d2
        bhi.s   mp_nomatch
        lea     prefix_buf(a3),a0
        bra.s   match_bytes
mp_match           moveq   #0,d0
        rts
mp_nomatch         moveq   #1,d0
        rts

; Compare D2 bytes at A0 and A2, advancing both pointers.
match_bytes        subq.w  #1,d2
mp_loop            move.b  (a0)+,d0
        bsr     fold_letter
        move.b  d0,d1
        move.b  (a2)+,d0
        bsr     fold_letter
        cmp.b   d0,d1
        bne.s   mp_return
        dbra    d2,mp_loop
mp_return          rts

; EXEC passes a word count, that many long channel IDs, then a QDOS string.
; The explicit path is stored as a QDOS string in the line buffer.
parse_args         moveq   #0,d0
        move.w  (a1)+,d0
        beq.s   pa_string
        movea.l (a1),a4            ; use first passed channel (#3) as default output!
pa_string         lsl.l   #2,d0
        adda.l  d0,a1
        moveq   #0,d0
        move.w  (a1)+,d0
        lea     0(a1,d0.l),a2
arg_next           cmpa.l  a2,a1
        beq     args_done
        move.b  (a1)+,d0
        bsr     arg_space
        beq.s   arg_next
        cmpi.b  #'#',d0
        beq.s   arg_channel
        cmpi.b  #'-',d0
        bne     arg_path
        cmpa.l  a2,a1
        beq   arg_error
        bsr   is_space
        beq   arg_error
arg_option         move.b  (a1)+,d0
        cmpi.b  #'1',d0
        beq.s   arg_one
        cmpi.b  #'r',d0
        beq.s   arg_flip
        moveq   #sort_name,d1
        cmpi.b  #'n',d0
        beq.s   arg_field
        moveq   #sort_size,d1
        cmpi.b  #'s',d0
        beq.s   arg_field
        moveq   #sort_date,d1
        cmpi.b  #'t',d0
        bne   arg_error
arg_field          move.b  d1,sort_field(a3)
        bra.s   arg_more
arg_one            move.b  #1,one_col(a3)
        bra.s   arg_more
arg_flip           move.b  #1,sort_flip(a3)
arg_more           cmpa.l  a2,a1
        beq   args_done
        bsr   is_space
        bne.s   arg_option
        bra.s   arg_next

arg_channel        moveq   #0,d1              ; parsed channel number
        moveq   #0,d2              ; digit count flag
chan_digit         cmpa.l  a2,a1
        beq.s   chan_done
        move.b  (a1),d0
        subi.b  #'0',d0
        bcs.s   chan_sep
        cmpi.b  #9,d0
        bhi.s   chan_sep
        addq.l  #1,a1
        moveq   #1,d2
        cmpi.w  #255,d1            ; prevent 16-bit overflow
        bhi     arg_error
        mulu.w  #10,d1
        ext.w   d0
        add.w   d0,d1
        bra.s   chan_digit

chan_sep           cmpi.b  #',',(a1)
        bne.s   chan_check_sp
        addq.l  #1,a1              ; consume optional comma (#3,snl1_)
        bra.s   chan_done
chan_check_sp      bsr     is_space
        bne     arg_error          ; reject junk like #3foo

chan_done          tst.w   d2
        beq     arg_error          ; reject bare '#' with no digits
        bsr     get_channel        ; sets A4 or returns ql_err_ch in D0
        tst.l   d0
        bne.s   chan_fail
        bra     arg_next
chan_fail          rts

; Look up SuperBASIC channel #D1.W in job 0's channel table.
; Expects A5 = sysvars. Returns A4 = QDOS channel ID, D0 = 0 (or ql_err_ch).
get_channel        movem.l a1,-(a7)
        cmpi.l  #smsq_id,(a5)
        beq.s   gc_smsq
        movea.l sv_basic(a5),a1
        lea     job_header(a1),a1
        bra.s   gc_lookup

gc_smsq            movea.l sv_jobs(a5),a1
        movea.l (a1),a1
        lea     sb_vars(a1),a1      ; SBASIC base relative to job zero's control block

gc_lookup          mulu.w  #bv_chlen,d1       ; D1 = n * entry size ($28)
        move.l  bv_chbas(a1),d0
        add.l   d1,d0
        cmp.l   bv_chtop(a1),d0
        bcc.s   gc_bad
        adda.l  d0,a1
        move.l  (a1),d0
        tst.w   d0                 ; closed entries have bit 15 set ($FFFF)
        bmi.s   gc_bad
        movea.l d0,a4
        moveq   #0,d0
        movem.l (a7)+,a1
        rts

gc_bad             moveq   #ql_err_ch,d0
        movem.l (a7)+,a1
        rts

arg_path           tst.w   (a3)
        bne.s   arg_error          ; only one directory operand
        lea     2(a3),a0
        moveq   #0,d1              ; number of path bytes
        moveq   #0,d2              ; closing quote for a quoted path
        cmpi.b  #34,d0
        bne.s   path_copy
        move.b  d0,d2
        bra.s   path_next
path_copy          cmpi.w  #line_len-2,d1
        beq   arg_error
        move.b  d0,(a0)+
        addq.w  #1,d1
path_next          cmpa.l  a2,a1
        beq.s   path_end
        move.b  (a1)+,d0
        tst.b   d2
        beq.s   path_word
        cmp.b   d2,d0
        bne.s   path_copy
        moveq   #0,d2
        cmpa.l  a2,a1
        beq.s   path_end
        bsr   is_space
        bne   arg_error
        bra.s   path_end
path_word          bsr   arg_space
        bne.s   path_copy
path_end           tst.b   d2
        bne   arg_error
        tst.w   d1
        beq   arg_error
        move.w  d1,(a3)
        bra     arg_next
args_done          moveq   #0,d0
        rts
arg_error          moveq   #ql_err_bp,d0
        rts
is_space           move.b  (a1),d0
arg_space          cmpi.b  #' ',d0
        beq.s   space_ok
        cmpi.b  #9,d0
space_ok           rts

; Copy the live record into the arena and insert it after any equal keys.
; A6 = directory record, D6.W = name length. Returns QDOS status in D0.
collect            moveq   #ent_name+1,d7
        add.w   d6,d7
        andi.w  #$fffe,d7
        move.l  block_next(a3),d0
        add.l   d7,d0
        cmp.l   block_end(a3),d0
        bls.s   have_space

        move.l  #block_size,d1
        moveq   #-1,d2             ; heap block owned by this job
        moveq   #ql_mt_alchp,d0
        move.l  a3,-(a7)
        trap    #1
        movea.l (a7)+,a3
        tst.l   d0
        bne     saved
        move.l  block_head(a3),(a0)
        move.l  a0,block_head(a3)
        lea     block_size(a0),a1
        move.l  a1,block_end(a3)
        addq.l  #4,a0
        move.l  a0,block_next(a3)
        move.l  a0,d0
        add.l   d7,d0
have_space         movea.l block_next(a3),a0
        move.l  d0,block_next(a3)
        move.l  (a6),d0
        subi.l  #hdr_len,d0
        cmpi.b  #-1,hdr_type(a6)
        bne.s   save_size
        moveq   #0,d0              ; directories display and sort as zero bytes
save_size
        move.l  d0,ent_size(a0)
        move.l  hdr_date(a6),ent_date(a0)
        move.b  hdr_type(a6),ent_type(a0)
        move.b  d6,ent_nlen(a0)
        lea     ent_name(a0),a1
        lea     hdr_name(a6),a2
        move.w  d6,d0
        subq.w  #1,d0
save_name          move.b  (a2)+,(a1)+
        dbra    d0,save_name

        lea     entry_head(a3),a1
        move.l  entry_tail(a3),d0
        beq.s   append_entry
        movea.l d0,a2
        bsr.s   cmp_entries
        bcs.s   find_position
        movea.l a2,a1              ; append after the tail, including equal keys
append_entry       move.l  a0,entry_tail(a3)
        bra.s   insert_entry

; The tail sorts after this entry, so the scan always finds a successor.
find_position      move.l  (a1),d0
        movea.l d0,a2
        bsr.s   cmp_entries
        bcs.s   insert_entry
        movea.l a2,a1              ; next link is at offset zero
        bra.s   find_position
insert_entry       move.l  (a1),(a0)
        move.l  a0,(a1)
        moveq   #0,d0
saved              rts

; Compare the selected field at A0 and A2. Carry means A0 sorts first.
; Size and date are unsigned longwords. Equal keys keep directory order.
cmp_entries        moveq   #0,d0
        move.b  sort_field(a3),d0
        move.b  sort_flip(a3),d1
        cmpi.w  #sort_date,d0
        bne.s   cmp_dir
        eori.b  #1,d1              ; date defaults to newest first
cmp_dir            tst.b   d1
        beq.s   cmp_key
        exg     a0,a2
        bsr.s   cmp_key
        exg     a0,a2              ; restore arguments without changing carry
        rts
cmp_key            tst.w   d0
        beq.s   cmp_names
        move.l  0(a0,d0.w),d1
        cmp.l   0(a2,d0.w),d1
        rts

; Compare the names at A0 and A2. Carry means A0 sorts first.
cmp_names          movem.l a0-a2,-(a7)
        moveq   #0,d2
        move.b  ent_nlen(a0),d2
        moveq   #0,d3
        move.b  ent_nlen(a2),d3
        lea     ent_name(a0),a0
        lea     ent_name(a2),a2
cmp_byte           tst.w   d2
        beq.s   cmp_len
        tst.w   d3
        beq.s   cmp_len
        move.b  (a0)+,d0
        bsr.s   fold_letter
        move.b  d0,d1
        move.b  (a2)+,d0
        bsr.s   fold_letter
        cmp.b   d0,d1
        bne.s   cmp_done
        subq.w  #1,d2
        subq.w  #1,d3
        bra.s   cmp_byte
cmp_len            cmp.w   d3,d2
cmp_done           movem.l (a7)+,a0-a2
        rts

fold_letter        cmpi.b  #'A',d0
        bcs.s   fold_done
        cmpi.b  #'Z',d0
        bhi.s   fold_ql
        addi.b  #32,d0
        rts
fold_ql            cmpi.b  #$a0,d0          ; QL accented uppercase letters
        bcs.s   fold_done
        cmpi.b  #$aa,d0
        bhi.s   fold_done
        subi.b  #32,d0
fold_done          rts

; A6 = packed entry, A3 = line buffer, D6.W = filename length.
; Returns the number of bytes to send in D2.W.
format_line        movea.l a3,a1
        tst.b   one_col(a3)
        bne.s   name_only
        lea     powers(pc),a2
        move.l  ent_size(a6),d0
        moveq   #0,d7
        cmpi.l  #999999,d0
        bls.s   size_setup
        lsr.l   #8,d0
        lsr.l   #2,d0
        moveq   #'K',d7
size_setup         moveq   #0,d5
        moveq   #5,d4
size_digit         bsr     decimal_digit
        or.b    d1,d5
        bne.s   size_print
        cmpi.w  #5,d4               ; six columns, including any K suffix
        beq.s   size_next
        tst.b   d7
        beq.s   size_pad
        cmpi.w  #4,d4
        beq.s   size_next
size_pad           move.b  #-16,d1  ; space after adding ASCII '0'
size_print         addi.b  #48,d1
        move.b  d1,(a1)+
size_next          dbra    d4,size_digit
        addi.b  #48,d0
        move.b  d0,(a1)+
        tst.b   d7
        beq.s   size_done
        move.b  d7,(a1)+
size_done          move.b  #' ',(a1)+

        move.l  ent_date(a6),d0
        bsr     format_date
        move.b  #' ',(a1)+
name_only       lea  ent_name(a6),a2
        subq.w  #1,d6
copy_name          move.b  (a2)+,(a1)+
        dbra    d6,copy_name
        tst.b   one_col(a3)
        bne.s   end_line
        cmpi.b  #-1,ent_type(a6)
        bne.s   check_exec
        move.b  #' ',(a1)+
        move.b  #'-',(a1)+
        move.b  #'>',(a1)+
        bra.s   end_line
check_exec         cmpi.b  #1,ent_type(a6)
        bne.s   end_line
        move.b  #'*',(a1)+
end_line           move.b  #10,(a1)+
        move.l  a1,d2
        sub.l   a3,d2
        rts

; D0.L = unsigned seconds from 1961-01-01. The 32-bit range
; ends in 2097, so all years divisible by four here are leap years.
format_date        tst.l   d0
        bne.s   dated_entry
        lea     no_date(pc),a2
        moveq   #15,d1
blank_date         move.b  (a2)+,(a1)+
        dbra    d1,blank_date
        rts
dated_entry        move.w  #1961,d4
find_year          move.l  #31536000,d2
        move.w  d4,d5
        andi.w  #3,d5
        bne.s   year_length
        addi.l  #86400,d2
year_length        cmp.l   d2,d0
        bcs.s   found_year
        sub.l   d2,d0
        addq.w  #1,d4
        bra.s   find_year
found_year         move.l  d0,d3
        moveq   #0,d0
        move.w  d4,d0
        lea     year_powers(pc),a2
        bsr     emit_digit
        bsr     emit_digit
        bsr     emit_digit
        addi.b  #48,d0
        move.b  d0,(a1)+
        move.b  #'-',(a1)+

        move.l  d3,d0
        lea     month_seconds(pc),a2
        moveq   #1,d4
find_month         move.l  (a2)+,d2
        cmpi.w  #2,d4
        bne.s   month_length
        tst.w   d5
        bne.s   month_length
        addi.l  #86400,d2
month_length       cmp.l   d2,d0
        bcs.s   found_month
        sub.l   d2,d0
        addq.w  #1,d4
        bra.s   find_month
found_month        move.l  d0,d3
        move.w  d4,d0
        bsr     two_digits
        move.b  #'-',(a1)+
        move.l  d3,d0
        lea     time_units(pc),a2
        bsr     decimal_digit       ; at most 30 days, counted from zero
        addq.w  #1,d1
        move.l  d0,d3
        move.w  d1,d0
        bsr     two_digits
        move.b  #' ',(a1)+

        move.l  d3,d0
        bsr     decimal_digit
        move.l  d0,d3
        move.w  d1,d0
        bsr     two_digits
        move.b  #':',(a1)+
        move.l  d3,d0
        divu    #60,d0              ; seconds remaining in the hour

; Emit the unsigned word in D0 as two digits.
two_digits         andi.l  #$ffff,d0
        divu    #10,d0
        addi.b  #48,d0
        move.b  d0,(a1)+
        swap    d0
        addi.b  #48,d0
        move.b  d0,(a1)+
        rts

emit_digit         bsr.s   decimal_digit
        addi.b  #48,d1
        move.b  d1,(a1)+
        rts

; Consume a unit from (A2)+, returning quotient in D1 and remainder in D0.
decimal_digit      moveq   #0,d1
        move.l  (a2)+,d2
divide_unit        cmp.l   d2,d0
        bcs.s   unit_done
        sub.l   d2,d0
        addq.w  #1,d1
        bra.s   divide_unit
unit_done          rts

powers             dc.l    1000000,100000,10000,1000,100,10
year_powers        dc.l    1000,100,10
time_units         dc.l    86400,3600
month_seconds      dc.l    2678400,2419200,2678400,2592000,2678400,2592000
        dc.l    2678400,2678400,2592000,2678400,2592000,2678400
no_date            dc.b    '       -        '
stock_default      dc.w    5
        dc.b    'MDV1_',0
        end
